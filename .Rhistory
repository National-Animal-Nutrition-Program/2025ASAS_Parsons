## Jags model ----
# Define the model
model_string <- "
model {
for (i in 1:N) {
y[i] ~ dnorm(mu[i], tau)
mu[i] <- beta0 + beta1 * x[i]
}
# Priors
beta0 ~ dunif(-10, 10)
beta1 ~ dunif(-1, 1)
sigma ~ dunif(0, 100)
tau <- 1 / (sigma * sigma)
}
"
# Initial values
inits <- list(list(beta0 = 0, beta1 = 0, sigma = 1))
# Parameters to monitor
(params <- c("beta0", "beta1", "sigma", 'y'))
# Run the model
model <- jags.model(textConnection(model_string), data = data_list, inits = inits, n.chains = 1)
# Data list ----
# Data
data_list <- list(
x = heifer$cvDMI,  # Example predictor values
y = heifer$Day56_ADG, # Example response values
N = nrow(heifer)     # Number of observations
)
# Run the model
model <- jags.model(textConnection(model_string), data = data_list, inits = inits, n.chains = 1)
update(model, 1000)  # Burn-in
samples <- coda.samples(model, variable.names = params, n.iter = 5000)
View(samples)
beta0chain = MCMCchains(samples, params = 'beta0')
plot(density(beta0chain), main = "beta0chain")
rug(beta0chain, co = 'red')
abline(v = quantile(beta0chain, c(.025, .975)), col = "red", lwd = 2)
quantile(beta0chain, c(.025, .975))
beta1chain = MCMCchains(samples, params = 'beta1')
plot(density(beta1chain), main = 'beta1chain')
rug(beta1chain, col = 'blue')
abline(v = quantile(beta1chain, c(.025, .975)), col = "red", lwd = 2)
quantile(beta1chain, c(.025, .975))
y = MCMCpstr(samples, params = 'y')
plot(density(y$y), main = 'y')
rug(y$y, col = 'blue')
abline(v = quantile(y$y, c(.025, .975)), col = "red", lwd = 2)
quantile(y$y, c(.025, .975))
