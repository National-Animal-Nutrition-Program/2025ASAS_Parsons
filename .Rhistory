y[i] ~ dnorm(mu[i], tau)
mu[i] <- beta[group[i]]  # Group-specific mean
}
# Priors
for (k in 1:K) {
beta[k] ~ dnorm(0, 0.001)  # Vague prior for group means
}
tau ~ dgamma(0.001, 0.001)   # Precision (1/variance)
sigma <- 1 / sqrt(tau)       # Standard deviation
}
"
# Initial values
inits <- list(
list(beta0 = 0, beta1 = 0, sigma = 1)
)
# Parameters to monitor
(params <- c("beta0", "beta1", "sigma", 'y'))
# Run the model
model <- jags.model(textConnection(model_string), data = data_list, inits = inits, n.chains = 1)
update(model, 1000)  # Burn-in
samples <- coda.samples(model, variable.names = params, n.iter = 5000)
