## Jags model ----
# Define the model
model_string <- "
model {
# Likelihood
for (i in 1:N) {
y[i] ~ dnorm(mu[i], tau)
mu[i] <- beta[treatment[i]]  # Treatment-specific mean
}
# Priors
for (k in 1:K) {
beta[k] ~ dnorm(0, 0.001)  # Vague prior for treatment means
}
tau ~ dgamma(0.001, 0.001)   # Precision (1/variance)
sigma <- 1 / sqrt(tau)       # Standard deviation
# Derived quantity: difference between treatments (B - A)
delta <- beta[2] - beta[1]
}
"
# Write model to a temporary file
writeLines(model_string, "model.txt")
# Initialize JAGS model
jags_model <- jags.model(
file = "model.txt",
data = data_list,
n.chains = 3,  # Number of MCMC chains
n.adapt = 1000 # Adaptation period
)
## Jags model ----
# Define the model
model_string <- "
model {
# Likelihood
for (i in 1:N) {
y[i] ~ dnorm(mu[i], tau)
mu[i] <- beta[x[i]]  # Treatment-specific mean
}
# Priors
for (k in 1:K) {
beta[k] ~ dnorm(0, 0.001)  # Vague prior for treatment means
}
tau ~ dgamma(0.001, 0.001)   # Precision (1/variance)
sigma <- 1 / sqrt(tau)       # Standard deviation
# Derived quantity: difference between treatments (B - A)
delta <- beta[2] - beta[1]
}
"
# Write model to a temporary file
writeLines(model_string, "model.txt")
# Initialize JAGS model
jags_model <- jags.model(
file = "model.txt",
data = data_list,
n.chains = 3,  # Number of MCMC chains
n.adapt = 1000 # Adaptation period
)
# Burn-in
update(jags_model, n.iter = 1000)
# Sample from posterior
samples <- coda.samples(
jags_model,
variable.names = c("beta", "sigma", "delta"),
n.iter = 5000
)
# Summarize results
summary(samples)
# Optional: Plot posterior distributions
plot(samples)
